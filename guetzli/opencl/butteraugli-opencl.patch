+// Test-only entry points. The OpenCL port in opencl/ is validated
+// against these stage by stage; they exist only because the functions they
+// wrap have internal linkage.
+namespace testhooks {
+
+void SeparateFrequencies(size_t xsize, size_t ysize,
+                         const std::vector<ImageF>& xyb, PsychoImage& ps) {
+  ::butteraugli::SeparateFrequencies(xsize, ysize, xyb, ps);
+}
+
+void L2Diff(const ImageF& i0, const ImageF& i1, double w, ImageF* diffmap) {
+  ::butteraugli::L2Diff(i0, i1, w, diffmap);
+}
+
+void L2DiffAsymmetric(const ImageF& i0, const ImageF& i1, double w_0gt1,
+                      double w_0lt1, ImageF* diffmap) {
+  ::butteraugli::L2DiffAsymmetric(i0, i1, w_0gt1, w_0lt1, diffmap);
+}
+
+void SameNoiseLevels(const ImageF& i0, const ImageF& i1, double kSigma,
+                     double w, double maxclamp, ImageF* diffmap) {
+  ::butteraugli::SameNoiseLevels(i0, i1, kSigma, w, maxclamp, diffmap);
+}
+
+// len and mulli are repeated from ButteraugliComparator::MaltaDiffMap{,LF};
+// they are function-local constants there, so there is nothing to share.
+void MaltaDiffMap(bool lf, const ImageF& lum0, const ImageF& lum1,
+                  size_t xsize, size_t ysize, double w_0gt1, double w_0lt1,
+                  double norm1, ImageF* block_diff_ac) {
+  const double len = 3.75;
+  if (lf) {
+    MaltaDiffMapImpl<MaltaTagLF>(lum0, lum1, xsize, ysize, w_0gt1, w_0lt1,
+                                 norm1, len, 0.405371989604, block_diff_ac);
+  } else {
+    MaltaDiffMapImpl<MaltaTag>(lum0, lum1, xsize, ysize, w_0gt1, w_0lt1, norm1,
+                               len, 0.354191303559, block_diff_ac);
+  }
+}
+
+ImageF DiffPrecompute(const ImageF& xyb0, const ImageF& xyb1) {
+  return ::butteraugli::DiffPrecompute(xyb0, xyb1);
+}
+
+void Mask(const std::vector<ImageF>& xyb0, const std::vector<ImageF>& xyb1,
+          std::vector<ImageF>* mask, std::vector<ImageF>* mask_dc) {
+  ::butteraugli::Mask(xyb0, xyb1, mask, mask_dc);
+}
+
+void MaskPsychoImage(const PsychoImage& pi0, const PsychoImage& pi1,
+                     size_t xsize, size_t ysize, std::vector<ImageF>* mask,
+                     std::vector<ImageF>* mask_dc) {
+  ::butteraugli::MaskPsychoImage(pi0, pi1, xsize, ysize, mask, mask_dc);
+}
+
+ImageF CalculateDiffmap(const ImageF& diffmap_in) {
+  return ::butteraugli::CalculateDiffmap(diffmap_in);
+}
