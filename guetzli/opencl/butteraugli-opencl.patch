+// The GPU port's working set. pi0 is uploaded once in the constructor and
+// stays resident across the ~100 comparisons guetzli makes; xyb and pi1 are
+// reused so that a comparison allocates nothing.
+struct ButteraugliComparator::GpuState {
+  clba::Psycho pi0;
+  clba::Psycho pi1;
+  clba::Plane xyb[3];
+  clba::Plane result;
+};
+
+namespace {
+
+void UploadPlane(const ImageF& src, clba::Plane* dst) {
+  dst->Alloc(src.xsize(), src.ysize());
+  dst->Upload(src.Row(0), src.bytes_per_row() / sizeof(float));
+}
+
+void UploadPsycho(const PsychoImage& src, clba::Psycho* dst) {
+  for (int i = 0; i < 3; ++i) {
+    UploadPlane(src.lf[i], &dst->lf[i]);
+    UploadPlane(src.mf[i], &dst->mf[i]);
+  }
+  for (int i = 0; i < 2; ++i) {
+    UploadPlane(src.hf[i], &dst->hf[i]);
+    UploadPlane(src.uhf[i], &dst->uhf[i]);
+  }
+}
+
+}  // namespace
+
 ButteraugliComparator::ButteraugliComparator(const std::vector<ImageF>& rgb0)
     : xsize_(rgb0[0].xsize()),
       ysize_(rgb0[0].ysize()),
-      num_pixels_(xsize_ * ysize_) {
+      num_pixels_(xsize_ * ysize_),
+      gpu_(nullptr) {
   if (xsize_ < 8 || ysize_ < 8) return;
   std::vector<ImageF> xyb0 = OpsinDynamicsImage(rgb0);
   SeparateFrequencies(xsize_, ysize_, xyb0, pi0_);
+  if (clba::Available()) {
+    gpu_ = new GpuState;
+    UploadPsycho(pi0_, &gpu_->pi0);
+  }
 }
 
+ButteraugliComparator::~ButteraugliComparator() { delete gpu_; }
+
 void ButteraugliComparator::Mask(
     std::vector<ImageF>* BUTTERAUGLI_RESTRICT mask,
     std::vector<ImageF>* BUTTERAUGLI_RESTRICT mask_dc) const {
@@ -808,9 +849,19 @@ void ButteraugliComparator::DiffmapOpsinDynamicsImage(
     ImageF &result) const {
   PROFILER_FUNC;
   if (xsize_ < 8 || ysize_ < 8) return;
+  result = ImageF(xsize_, ysize_);
+  if (gpu_ != nullptr) {
+    // The GPU path is bit-exact against the CPU one, so this is not an
+    // approximation: see clba_test, which compares them stage by stage.
+    for (int c = 0; c < 3; ++c) UploadPlane(xyb1[c], &gpu_->xyb[c]);
+    clba::SeparateFrequencies(gpu_->xyb, &gpu_->pi1);
+    clba::DiffmapPsychoImage(gpu_->pi0, gpu_->pi1, &gpu_->result);
+    gpu_->result.Download(result.Row(0),
+                          result.bytes_per_row() / sizeof(float));
+    return;
+  }
   PsychoImage pi1;
   SeparateFrequencies(xsize_, ysize_, xyb1, pi1);
-  result = ImageF(xsize_, ysize_);
   DiffmapPsychoImage(pi1, result);
 }
 
@@ -1991,4 +2042,65 @@ void CreateHeatMapImage(const std::vector<float>& distmap,
   }
 }
 
