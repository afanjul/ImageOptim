 #include <algorithm>
 #include <array>
 
+// The OpenCL port of the expensive half of this file. It is a bit-exact
+// reimplementation, not an approximation, and it degrades to the CPU code
+// here whenever no usable GPU is present.
+#include "opencl/clba.h"
 
