-  std::vector<ImageF> rgb0 =
-      ::butteraugli::OpsinDynamicsImage(LinearRgb(width_, height_, rgb_orig_));
+  // Upstream computes OpsinDynamicsImage(LinearRgb(rgb_orig_)) here and never
+  // reads it; comparator_ already holds the decomposition of the original.
+  // The compiler cannot drop it, so it costs a full opsin pass per comparison
+  // -- about a sixth of this build's total time. Output is unaffected.
   std::vector<std::vector<float> > rgb(3, std::vector<float>(width_ * height_));
   img.ToLinearRGB(&rgb);
   const std::vector<ImageF> rgb_planes = PlanesFromPacked(width_, height_, rgb);
